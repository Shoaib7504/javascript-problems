// Find the factorial of a number
const factorial = (n) => {
    if (n < 0) return console.log("Factorial not defined for negative numbers");
    let result = 1;
    for (let i = 2; i <= n; i++) {
        result *= i;
    }
    return console.log(`Factorial of ${n} is ${result}`);
}
factorial(5);
factorial(7);
factorial(0);
